<?jelly escape-by-default='true'?>
<!-- Shown read-only: UpCloudComputer grants nobody the permission to configure an agent. -->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Cloud}">
    <f:readOnlyTextbox value="${instance.cloudName}"/>
  </f:entry>
  <f:entry title="${%Template}">
    <f:readOnlyTextbox value="${instance.template.name}"/>
  </f:entry>
  <f:entry title="${%UpCloud server}">
    <f:readOnlyTextbox value="${instance.serverUuid}"/>
  </f:entry>
  <f:entry title="${%Labels}">
    <f:readOnlyTextbox value="${instance.labelString}"/>
  </f:entry>
  <f:entry title="${%Number of executors}">
    <f:readOnlyTextbox value="${instance.numExecutors}"/>
  </f:entry>
  <f:entry title="${%Remote root directory}">
    <f:readOnlyTextbox value="${instance.remoteFS}"/>
  </f:entry>
</j:jelly>
