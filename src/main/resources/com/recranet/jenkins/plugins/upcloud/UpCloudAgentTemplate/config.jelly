<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Name}" field="name">
    <f:textbox clazz="required"/>
  </f:entry>

  <f:entry title="${%Labels}" field="labelString">
    <f:textbox/>
  </f:entry>

  <f:slave-mode name="mode" node="${instance}"/>

  <f:entry title="${%Number of executors}" field="numExecutors">
    <f:number default="1" min="1"/>
  </f:entry>

  <f:section title="${%Server}">
    <f:entry title="${%Zone}" field="zone">
      <f:select/>
    </f:entry>

    <f:entry title="${%Plan}" field="plan">
      <f:select/>
    </f:entry>

    <f:entry title="${%Image}" field="image">
      <f:select/>
    </f:entry>

    <f:entry title="${%Initialization script}" field="userData">
      <f:textarea/>
    </f:entry>

    <f:advanced>
      <f:entry title="${%Storage size (GB)}" field="storageSizeGb">
        <f:number default="0" min="0"/>
      </f:entry>

      <f:entry title="${%Storage tier}" field="storageTier">
        <f:select/>
      </f:entry>
    </f:advanced>
  </f:section>

  <f:section title="${%Network}">
    <f:entry field="publicIpv4">
      <f:checkbox title="${%Public IPv4}" default="true"/>
    </f:entry>

    <f:entry field="publicIpv6">
      <f:checkbox title="${%Public IPv6}"/>
    </f:entry>

    <f:entry field="utilityNetwork">
      <f:checkbox title="${%Utility network}" default="true"/>
    </f:entry>

    <f:entry title="${%SDN private network}" field="privateNetwork">
      <f:select/>
    </f:entry>

    <f:entry title="${%Connect to the agent over}" field="connectionNetwork">
      <f:select/>
    </f:entry>
  </f:section>

  <f:section title="${%Agent}">
    <f:entry title="${%SSH credentials}" field="sshCredentialsId">
      <c:select/>
    </f:entry>

    <f:entry title="${%Remote root directory}" field="remoteFs">
      <f:textbox default="/home/jenkins"/>
    </f:entry>

    <f:dropdownDescriptorSelector title="${%Remove an idle agent}" field="shutdownPolicy"/>

    <f:entry title="${%Instance cap}" field="instanceCap">
      <f:number default="0" min="0"/>
    </f:entry>

    <f:advanced>
      <f:entry title="${%SSH port}" field="sshPort">
        <f:number default="22" min="1" max="65535"/>
      </f:entry>

      <f:entry title="${%Startup timeout (seconds)}" field="startupTimeoutSeconds">
        <f:number default="600" min="1"/>
      </f:entry>

      <f:entry title="${%Java path}" field="javaPath">
        <f:textbox/>
      </f:entry>

      <f:entry title="${%JVM options}" field="jvmOptions">
        <f:textbox/>
      </f:entry>
    </f:advanced>

    <f:descriptorList title="${%Node properties}" field="nodeProperties"
                      descriptors="${descriptor.nodePropertyDescriptors}"/>
  </f:section>
</j:jelly>
