<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Name}" field="name">
    <f:textbox clazz="required"/>
  </f:entry>

  <f:entry title="${%API credentials}" field="credentialsId">
    <c:select/>
  </f:entry>

  <f:validateButton title="${%Test connection}" progress="${%Testing...}" method="testConnection"
                    with="credentialsId"/>

  <f:entry title="${%Instance cap}" field="instanceCap">
    <f:number default="0" min="0"/>
  </f:entry>

  <f:entry field="noDelayProvisioning">
    <f:checkbox title="${%Provision agents without delay}" default="true"/>
  </f:entry>

  <f:entry field="cleanupOrphanedServers">
    <f:checkbox title="${%Delete orphaned servers}" default="true"/>
  </f:entry>

  <f:entry title="${%Agent templates}">
    <f:repeatableProperty field="templates" header="${%Agent template}" add="${%Add template}">
      <f:block>
        <div align="right">
          <f:repeatableDeleteButton/>
        </div>
      </f:block>
    </f:repeatableProperty>
  </f:entry>
</j:jelly>
